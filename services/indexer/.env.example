# Local-only services from this directory's docker-compose.yml.
# Copy to .env, start Docker services, then use `pnpm start`.
ENVIO_PG_PORT=5434
ENVIO_PG_SCHEMA=creator_stakes
HASURA_GRAPHQL_ENDPOINT=http://localhost:8081/v1/metadata
ENVIO_INDEXER_PORT=9899
ENVIO_TUI=false
ENVIO_API_TOKEN=
# Optional keyed Monad testnet RPC for faster sync; defaults to the public endpoint.
ENVIO_MONAD_RPC_URL=

# Mainnet creator fees and swaps; read-only indexing, no signing.
ENVIO_MONAD_MAINNET_RPC_URL=
