{
  "manifest_version": 3,
  "name": "No More Bluff — development",
  "description": "Separate recorded X bindings and indexed testnet stake evidence, with wallet review handoff.",
  "version": "0.2.0",
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "No More Bluff" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
