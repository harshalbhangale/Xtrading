{
  "manifest_version": 3,
  "name": "Tradepost",
  "description": "Creator records, trade-call detection, reviewed Kuru/Perpl trades and opt-in viewed-follow sync on X.",
  "version": "0.5.0",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tradepost"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
