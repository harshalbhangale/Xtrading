{
  "manifest_version": 3,
  "name": "Tradepost",
  "description": "Verified-creator badges, trade-call detection, Nansen wallet checks and reviewed Kuru/Perpl trades on X.",
  "version": "0.3.0",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tradepost"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
