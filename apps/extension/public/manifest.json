{
  "manifest_version": 3,
  "name": "Xtrading",
  "description": "Inline Kuru trading from X, creator analytics and verified payout registration on Monad.",
  "version": "0.8.0",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Xtrading",
    "default_icon": {
      "128": "xtrading-logo.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "128": "xtrading-logo.png"
  }
}
