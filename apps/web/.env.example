# Copy to apps/web/.env.local. Keep server credentials out of NEXT_PUBLIC_*.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
KURU_MARKET_ADDRESS=0xa241896A7Dbe8a550D2E5fF7A914bB1989ceD2D9
CREATOR_STAKE_ADDRESS=
# Nansen: MON call prices and wallet checks (Monad mainnet coverage). Empty = unavailable.
NANSEN_API_KEY=
ENVIO_GRAPHQL_URL=
ENVIO_HASURA_ADMIN_SECRET=
DATABASE_URL=postgresql://cmb:cmb_local@localhost:5433/call_my_bluff
# Trusted CA for a remote RDS connection: a file path locally, or the PEM text itself
# on hosted runtimes (the ap-south-1 regional bundle fits in an env var).
DATABASE_CA_FILE=
DATABASE_CA_PEM=

# Explicit mock demo mode requires a separately deployed MockUSDC and matching stake contract.
STAKE_TOKEN_MODE=circle
MOCK_USDC_ADDRESS=
# Chainlink CRE-settled call bonds (contracts/deployments/call-settlement-monad-testnet.json).
CALL_SETTLEMENT_ADDRESS=

# Call extraction with Groq. Empty = deterministic rules extractor, labelled in the UI.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Perpl testnet API key (Ed25519 key pair from https://testnet.perpl.xyz). The account must
# enable order forwarding. Without all three values, perp orders are validated but never sent.
PERPL_API_URL=https://testnet.perpl.xyz/api
PERPL_API_KEY=
PERPL_API_KEY_SECRET=
PERPL_ACCOUNT_ID=
PERPL_MAX_LEVERAGE=5
# Maximum position size per order, in the market's base asset.
PERPL_MAX_SIZE=1
# Live Perpl orders run on the account above via its API key, not users' wallets.
# Only these comma-separated stable X user IDs may send them; others stay in demo.
PERPL_OPERATOR_X_USER_IDS=
