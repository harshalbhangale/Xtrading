# Copy to apps/web/.env.local. Keep server credentials out of NEXT_PUBLIC_*.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
KURU_MARKET_ADDRESS=0xa241896A7Dbe8a550D2E5fF7A914bB1989ceD2D9
CREATOR_STAKE_ADDRESS=
# Nansen: MON call prices and wallet checks (Monad mainnet coverage). Empty = unavailable.
NANSEN_API_KEY=
ENVIO_API_TOKEN=
ENVIO_GRAPHQL_URL=
ENVIO_HASURA_ADMIN_SECRET=
DATABASE_URL=postgresql://cmb:cmb_local@localhost:5433/call_my_bluff
# Trusted CA for a remote RDS connection: a file path locally, or the PEM text itself
# on hosted runtimes (the ap-south-1 regional bundle fits in an env var).
DATABASE_CA_FILE=
DATABASE_CA_PEM=

# Call extraction with Groq. Empty = deterministic rules extractor, labelled in the UI.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Perpl testnet perps. Each user's own wallet signs execOrder on Perpl's Exchange and
# trades its own exchange account; the server holds no Perpl key. Reads use MONAD_RPC_URL.
PERPL_MAX_LEVERAGE=5
# Maximum position size per order, in the market's base asset.
PERPL_MAX_SIZE=1

# Perpl on Monad mainnet (real AUSD). Off unless exactly "true"; never falls back to testnet.
# Reads use MONAD_MAINNET_RPC_URL. Each user's own wallet signs; the server holds no key.
PERPL_MAINNET_ENABLED=
# Mainnet caps. Leverage defaults to 3. AUSD margin one order may lock defaults to 50.
PERPL_MAINNET_MAX_LEVERAGE=3
PERPL_MAINNET_MAX_COLLATERAL=50
# Optional size cap in the market's base asset; empty means only the margin cap applies.
PERPL_MAINNET_MAX_SIZE=

# Kuru spot on Monad mainnet (real funds). Off unless exactly "true"; never falls back to testnet.
KURU_MAINNET_ENABLED=
# Optional keyed mainnet RPC; defaults to https://rpc.monad.xyz.
MONAD_MAINNET_RPC_URL=

# Creator fees through the fixed Kuru Flow entrypoint. Disabled until fork/deployment checks pass.
CREATOR_FEES_ENABLED=
